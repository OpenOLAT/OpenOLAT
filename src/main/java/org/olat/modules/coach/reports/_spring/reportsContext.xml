<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans 
	                   http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- Reports -->
	<bean id="coaching.openbookingorders" class="org.olat.modules.coach.reports.OpenBookingOrdersReportConfiguration">
		<property name="order" value="1" />
		<property name="i18nNameKey" value="report.name.openBookingOrders" />
		<property name="i18nDescriptionKey" value="report.description.openBookingOrders" />
	</bean>

	<bean id="coaching.absences" class="org.olat.modules.coach.reports.AbsencesReportConfiguration">
		<property name="order" value="10" />
		<property name="i18nNameKey" value="report.name.absences" />
		<property name="i18nDescriptionKey" value="report.description.absences" />
	</bean>

	<bean id="coaching.certificates" class="org.olat.modules.coach.reports.CertificatesReportConfiguration">
		<property name="order" value="30" />
		<property name="i18nNameKey" value="report.name.certificates" />
		<property name="i18nDescriptionKey" value="report.description.certificates" />
	</bean>

</beans>
	